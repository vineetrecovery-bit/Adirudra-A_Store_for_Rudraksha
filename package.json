{
  "name": "adirudra-store",
  "version": "1.0.0",
  "private": true,
  "description": "Adirudra Rudraksha e-commerce store (Node.js + Express)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "db:import": "node --env-file-if-exists=.env database/mysql/import-json.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.24.6"
  }
}
