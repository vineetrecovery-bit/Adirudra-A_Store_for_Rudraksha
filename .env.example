# Copy this file to .env and fill in the values.
PORT=3000
NODE_ENV=development

# Folder for locally saved product photos/videos (and all the tables, if MySQL
# isn't set up). On Hostinger, use a folder OUTSIDE the project so redeploys can't wipe it,
# e.g. /home/u123456789/adirudra-data. Default: database/data/
DATA_DIR=

# MySQL database: tables user_groups, users, products, orders, settings (created automatically).
# All times are stored in Indian Standard Time.
# Hostinger: hPanel > Databases > MySQL Databases. Host is usually "localhost".
# Leave DB_HOST empty to store the tables in JSON files instead.
# Moving existing JSON data in: npm run db:import
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Cloudflare R2 for product photos and videos. Not linked yet (see database/media/r2.js);
# leave empty until then and media is saved on the server's disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
MAX_VIDEO_MB=50

# Shipping details saved on every order, for Shiprocket (integration comes later).
SHIPROCKET_PICKUP_LOCATION=Primary
SHIP_PACKAGING_GRAMS=100
SHIP_DEFAULT_ITEM_GRAMS=50
SHIP_BOX_LENGTH_CM=15
SHIP_BOX_BREADTH_CM=12
SHIP_BOX_HEIGHT_CM=8

# The one admin account. Sign in at /admin (or /login) with this mobile number + password.
# Customers create their own accounts on the website. Leave either empty to have no admin.
ADMIN_PHONE=
ADMIN_PASSWORD=
# Long random string; keeps admins signed in across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys while testing.
# Leave empty to disable online payment (UPI option then promises a payment link instead).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Store details
WHATSAPP_NUMBER=918527810632
STORE_EMAIL=adirudra.info@gmail.com
FREE_SHIPPING_OVER=999
SHIPPING_FEE=99
COD_FEE=49
